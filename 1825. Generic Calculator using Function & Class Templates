#include <iostream>
#include <string>
using namespace std;

// Function Template
template <typename T>
T add(T a, T b) {
    return a + b;
}

// Class Template
template <typename T>
class Calculator {
    T a, b;

public:
    Calculator(T x, T y) : a(x), b(y) {}

    T subtract() {
        return a - b;
    }

    T multiply() {
        return a * b;
    }
};

// Specialization for string
template <>
class Calculator<string> {
    string a, b;

public:
    Calculator(string x, string y) : a(x), b(y) {}

    string subtract() {
        return "Not Supported";
    }

    string multiply() {
        return "Not Supported";
    }
};

int main() {

    string type;
    cin >> type;

    if (type == "int") {
        int x, y;
        cin >> x >> y;

        Calculator<int> calc(x, y);

        cout << "Addition: " << add(x, y) << endl;
        cout << "Subtraction: " << calc.subtract() << endl;
        cout << "Multiplication: " << calc.multiply() << endl;
    }

    else if (type == "double") {
        double x, y;
        cin >> x >> y;

        Calculator<double> calc(x, y);

        cout << "Addition: " << add(x, y) << endl;
        cout << "Subtraction: " << calc.subtract() << endl;
        cout << "Multiplication: " << calc.multiply() << endl;
    }

    else if (type == "string") {
        string x, y;
        cin >> x >> y;

        Calculator<string> calc(x, y);

        cout << "Addition: " << add(x, y) << endl;
        cout << "Subtraction: " << calc.subtract() << endl;
        cout << "Multiplication: " << calc.multiply() << endl;
    }

    else {
        cout << "Invalid Type" << endl;
    }

    return 0;
}
